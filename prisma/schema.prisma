// GitRead data model.
// NextAuth adapter tables (User/Account/Session/VerificationToken) + app tables.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth (Auth.js) core models ───────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // GitHub profile mirror (minimal).
  githubLogin   String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  repositories Repository[]
  progress     ReadingProgress[]
  recentlyRead RecentlyRead[]
  bookmarks    Bookmark[]
  favorites    Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── GitRead app models ───────────────────────────────────────────

/// A repository a user has selected/pinned to read.
model Repository {
  id              String    @id @default(cuid())
  userId          String
  owner           String
  name            String
  fullName        String
  private         Boolean   @default(false)
  description     String?
  primaryLanguage String?
  stars           Int       @default(0)
  markdownCount   Int       @default(0)
  lastPushedAt    DateTime?
  pinned          Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fullName])
  @@index([userId, pinned])
}

/// Per-file reading progress + scroll memory. Powers "Continue reading".
model ReadingProgress {
  id           String   @id @default(cuid())
  userId       String
  repoFullName String
  filePath     String
  title        String?
  scrollPct    Float    @default(0)
  headingId    String?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoFullName, filePath])
  @@index([userId, updatedAt])
}

/// History of opened documents.
model RecentlyRead {
  id           String   @id @default(cuid())
  userId       String
  repoFullName String
  filePath     String
  title        String?
  openedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoFullName, filePath])
  @@index([userId, openedAt])
}

// ── Seams for later phases (schema only; unused in Phase 1 UI) ────
model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  repoFullName String
  filePath     String
  label        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoFullName, filePath])
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  repoFullName String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoFullName])
}
