# ─────────────────────────────────────────────────────────────
# GitRead environment. Copy to `.env` and fill in real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Auth.js (NextAuth v5) — generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# Base URL of the app. Optional locally (trustHost is enabled); set in production.
AUTH_URL="http://localhost:3000"

# GitHub OAuth App
#   Create at: https://github.com/settings/developers  → "New OAuth App"
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL="postgresql://gitread:gitread@localhost:5432/gitread?schema=public"

# Redis — optional. If omitted, caching degrades to a no-op (app still works).
REDIS_URL="redis://localhost:6379"
