# ─────────────────────────────────────────────────────────────
# GitRead environment. Copy to `.env` and fill in real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Auth.js (NextAuth v5) — generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# Base URL of the app. Optional locally (trustHost is enabled); set in production.
AUTH_URL="http://localhost:3000"

# GitHub OAuth App
#   Create at: https://github.com/settings/developers  → "New OAuth App"
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL="postgresql://gitread:gitread@localhost:5432/gitread?schema=public"

# Cache — optional. If none is configured, caching degrades to a no-op.
#
# Local dev: ioredis over TCP (matches docker-compose.yml).
REDIS_URL="redis://localhost:6379"
#
# Production (Vercel + Upstash): use the Upstash REST client instead of a TCP
# connection — it's stateless, so there's no per-request TLS handshake or
# dead-socket reconnect stall on serverless. Set these (the Vercel↔Upstash
# integration injects them automatically; KV_REST_API_* names also work). When
# present, they take priority over REDIS_URL.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
#
# Cache logging: prints HIT / MISS / ERR per key (and the active backend) to the
# server logs. On by default; set to "false" to silence.
CACHE_DEBUG="true"
