{
  "name": "gitread",
  "version": "0.1.0",
  "private": true,
  "description": "GitRead — turn GitHub Markdown repos into a premium reading experience.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
