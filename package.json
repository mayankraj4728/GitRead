    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "ioredis": "^5.4.2",
    "katex": "^0.16.19",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.4.1",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.25",
